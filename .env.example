# Server (local dev — Vercel sets PORT automatically)
PORT=8787
NODE_ENV=development

# Provider: mock | nivoda
DIAMOND_PROVIDER=mock

# Allowed browser origins (comma-separated). Include Shopify storefront + Vercel preview URLs.
CORS_ORIGINS=http://127.0.0.1:9292,https://primo-dev-p0bmd3ue.myshopify.com

# Nivoda staging / production (GraphQL — same pattern as theme-1 ring-builder)
NIVODA_API_URL=https://intg-customer-staging.nivodaapi.net/api/diamonds
NIVODA_USERNAME=
NIVODA_PASSWORD=

# Optional cache TTL (seconds) for search responses
DIAMOND_CACHE_TTL=60
